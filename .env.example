# Copy to .env (development) or .env.production and fill in real values.
PORT=3000

# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
# Local:        mongodb://localhost:27017/qr-food-ordering
MONGODB_URI=mongodb://localhost:27017/qr-food-ordering

# Required in production — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# The origin printed into table QR codes. ONE origin, no trailing slash.
# On a phone this must be a real public URL — localhost never resolves.
PUBLIC_APP_URL=http://localhost:5173

# CORS allowlist: comma-separated origins, no trailing slash.
FRONTEND_URL=http://localhost:5173
